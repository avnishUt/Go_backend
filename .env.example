APP_NAME=restaurant-inventory-api
APP_ENV=development
PORT=8080

HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=15
HTTP_IDLE_TIMEOUT_SECONDS=60
HTTP_SHUTDOWN_TIMEOUT_SECONDS=10
HTTP_MAX_BODY_BYTES=1048576

CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

METRICS_ENABLED=true

POSTGRES_URL=postgres://postgres:postgres@localhost:5432/restaurant?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MIN_OPEN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME_SECONDS=1800
POSTGRES_MAX_CONN_IDLE_TIME_SECONDS=300

MONGO_URL=
MONGO_DATABASE=restaurant_inventory_events

JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRY_SECONDS=86400
